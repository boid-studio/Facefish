#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Xform "Environment"
    {
        def Xform "Backdrop"
        {
            float3 xformOp:translate = (0, 0, -1.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "BubbleEmitter"
        {
            float3 xformOp:translate = (0, -0.3, -0.15)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
