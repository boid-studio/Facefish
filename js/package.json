{
  "name": "facefish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Three.js fish avatar driven by Face Cap (ARKit) live mode data, packaged for iPad with Capacitor.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "relay": "node relay/relay.mjs",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync ios",
    "cap:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
